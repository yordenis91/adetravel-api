// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ──────────────────────────────────────────

enum UserRole {
  ADMINISTRADOR
  USUARIO
}

enum AgencyRole {
  GERENTE
  FINANZAS
  OPERACIONES
  AGENTE_VENTAS
}

// Flujo granular de 17 estados compartido por Request y Service (ver src/validators/workflow-status.ts).
enum WorkflowStatus {
  RECEPCIONADA
  SERVICIOS_ASIGNADOS_PARA_COTIZAR
  ENVIADO_A_PROVEEDOR
  COTIZADO_POR_PROVEEDOR
  COTIZADO_POR_ADETRAVEL
  ENVIADO_AL_CLIENTE
  ACEPTADA_POR_CLIENTE
  ENVIADA_SOLICITUD_CONFIRMACION_PROVEEDOR
  CONFIRMADA_POR_PROVEEDOR
  ENVIADA_CONFIRMACION_CLIENTE
  ENVIADA_SOLICITUD_PAGO_CLIENTE
  PAGADO_POR_CLIENTE
  PAGADO_AL_PROVEEDOR
  VOUCHER_EMITIDO
  VOUCHER_ENTREGADO
  VENDIDA
  CANCELADA
}

enum ServiceType {
  SEGURO
  VISA
  ALOJAMIENTO
  PASAJE_AEREO
  ARRIENDO_AUTO
  EXCURSION
  TRASLADO
  CRUCERO
  CIRCUITO
}

enum QuotationStatus {
  BORRADOR
  ENVIADA
  ACEPTADA
  RECHAZADA
}

enum PaymentMethod {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
  CHEQUE
  WEBPAY
}

enum PaymentStatus {
  PENDIENTE
  COMPLETADO
  CANCELADO
}

enum VoucherStatus {
  BORRADOR
  EMITIDO
  CANCELADO
}

// ─── MODELS ─────────────────────────────────────────

model User {
  id                   String         @id @default(uuid())
  email                String         @unique
  fullName             String
  passwordHash         String
  role                 UserRole       @default(USUARIO)
  agencyRole           AgencyRole?
  department           String?
  phone                String?
  isActive             Boolean        @default(true)
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  tasks                Task[]
  notifications        Notification[]

  @@map("users")
}

model Client {
  id                    String   @id @default(uuid())
  firstName             String
  lastName              String
  email                 String?
  phone                 String?
  rut                   String?
  passportNumber        String?
  passportExpiry        String?
  passportIssueDate     String?
  passportCountry       String?
  birthDate             String?
  nationality           String?
  address               String?
  frequentFlyerNumbers  String[]
  restrictions          String?
  referralSource        String?
  bankAccount           String?
  bankName              String?
  bankAccountHolder     String?
  bankEmail             String?
  isActive              Boolean  @default(true)
  createdBy             String?
  lastBirthdayEmailYear Int?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  requests   Request[]
  quotations Quotation[]
  payments   Payment[]
  vouchers   Voucher[]
  services   Service[]

  @@map("clients")
}

model Provider {
  id                String   @id @default(uuid())
  name              String
  fantasyName       String?
  rut               String?
  country           String?
  city              String?
  address           String?
  phone             String?
  email             String?
  businessType      String?
  executiveName     String?
  executivePhone    String?
  executiveEmail    String?
  contactName       String?
  contactPhone      String?
  contactEmail      String?
  contactRut        String?
  bankAccount       String?
  bankName          String?
  bankAccountHolder String?
  paymentMethod     String?
  vatPercentage     Float?
  isActive          Boolean  @default(true)
  createdBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  vouchers      Voucher[]
  services      Service[]
  confirmations Confirmation[]

  @@map("providers")
}

model Request {
  id                 String         @id @default(uuid())
  requestNumber      String         @unique
  clientId           String
  isPackage          Boolean        @default(false)
  requestDate        String?
  originCountry      String?
  originCity         String?
  destinationCountry String?
  destinationCity    String?
  durationDays       Int?
  budgetMin          Float?
  budgetMax          Float?
  status             WorkflowStatus @default(RECEPCIONADA)
  description        String?
  services           String[]
  cancellationReason String?
  createdBy          String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  client        Client         @relation(fields: [clientId], references: [id])
  quotations    Quotation[]
  payments      Payment[]
  vouchers      Voucher[]
  servicesList  Service[]
  confirmations Confirmation[]

  @@map("requests")
}

model Service {
  id                 String         @id @default(uuid())
  serviceNumber      String         @unique
  requestId          String
  type               ServiceType
  status             WorkflowStatus @default(RECEPCIONADA)
  providerId         String?
  clientId           String? // null = cliente principal de la Solicitud (caso general); se usa para servicios personales (p.ej. Pasaje Aéreo)
  price              Float?
  currency           String         @default("CLP")
  details            Json // Campos específicos del tipo (ver src/validators/services.validator.ts)
  cancellationReason String?
  createdBy          String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  request       Request        @relation(fields: [requestId], references: [id])
  provider      Provider?      @relation(fields: [providerId], references: [id])
  client        Client?        @relation(fields: [clientId], references: [id])
  quotations    Quotation[]
  confirmations Confirmation[]

  @@map("services")
}

model Quotation {
  id                 String          @id @default(uuid())
  quotationNumber    String          @unique
  requestId          String
  serviceId          String? // null cuando isPackage=true (se trabaja con la Solicitud)
  clientId           String
  validUntil         String?
  status             QuotationStatus @default(BORRADOR)
  currency           String          @default("CLP")
  items              Json[] // Array de objetos: { service, description, quantity, unitPrice, total }
  subtotal           Float?
  taxPercentage      Float?          @default(19)
  taxAmount          Float?
  discount           Float?
  total              Float?
  notes              String?
  termsAndConditions String?
  createdBy          String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  request  Request   @relation(fields: [requestId], references: [id])
  service  Service?  @relation(fields: [serviceId], references: [id])
  client   Client    @relation(fields: [clientId], references: [id])
  payments Payment[]

  @@map("quotations")
}

model Confirmation {
  id                         String   @id @default(uuid())
  confirmationNumber         String   @unique
  requestId                  String
  serviceId                  String? // null cuando isPackage=true (se trabaja con la Solicitud)
  providerId                 String
  providerConfirmationNumber String?
  price                      Float
  validUntil                 String?
  exchangeRate               Float?
  notes                      String?
  createdBy                  String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  request  Request  @relation(fields: [requestId], references: [id])
  service  Service? @relation(fields: [serviceId], references: [id])
  provider Provider @relation(fields: [providerId], references: [id])

  @@map("confirmations")
}

model Payment {
  id            String        @id @default(uuid())
  paymentNumber String        @unique
  requestId     String
  quotationId   String?
  clientId      String
  amount        Float
  currency      String        @default("CLP")
  paymentDate   String?
  method        PaymentMethod
  status        PaymentStatus @default(PENDIENTE)
  reference     String?
  notes         String?
  createdBy     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  request   Request    @relation(fields: [requestId], references: [id])
  quotation Quotation? @relation(fields: [quotationId], references: [id])
  client    Client     @relation(fields: [clientId], references: [id])

  @@map("payments")
}

model Voucher {
  id               String        @id @default(uuid())
  voucherNumber    String        @unique
  requestId        String
  clientId         String
  providerId       String?
  serviceType      String?
  serviceName      String?
  serviceDetails   String?
  checkIn          String?
  checkOut         String?
  destination      String?
  passengerNames   String[]
  confirmationCode String?
  status           VoucherStatus @default(BORRADOR)
  notes            String?
  amount           Float?
  currency         String?
  createdBy        String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  request  Request   @relation(fields: [requestId], references: [id])
  client   Client    @relation(fields: [clientId], references: [id])
  provider Provider? @relation(fields: [providerId], references: [id])

  @@map("vouchers")
}

model ActivityLog {
  id          String   @id @default(uuid())
  action      String
  entityType  String
  entityId    String
  entityLabel String?
  description String?
  performedBy String?
  metadata    String? // JSON serializado
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("activity_logs")
}

model SystemConfig {
  id                           String   @id @default(uuid())
  agencyName                   String?
  agencyFantasyName            String?
  agencyRut                    String?
  agencyAddress                String?
  agencyPhone                  String?
  agencyEmail                  String?
  agencyWebsite                String?
  agencyLogoUrl                String?
  smtpHost                     String?
  smtpPort                     Int?
  smtpUser                     String?
  smtpPassword                 String?
  smtpFromName                 String?
  smtpFromEmail                String?
  smtpEncryption               String?
  notifyOnQuotationSent        Boolean  @default(false)
  notifyOnPaymentCompleted     Boolean  @default(false)
  notifyOnVoucherIssued        Boolean  @default(false)
  notifyOnRequestCreated       Boolean  @default(false)
  defaultCurrency              String?  @default("CLP")
  defaultTaxPercentage         Float?   @default(19)
  defaultQuotationValidityDays Int?     @default(15)
  defaultTermsAndConditions    String?
  defaultQuotationNotes        String?
  requestNumberPrefix          String?  @default("ADET")
  quotationNumberPrefix        String?  @default("COTIZ")
  paymentNumberPrefix          String?  @default("PAG")
  voucherNumberPrefix          String?  @default("VCH")
  serviceNumberPrefix          String?  @default("SRV")
  confirmationNumberPrefix     String?  @default("CONF")
  timezone                     String?  @default("America/Santiago")
  exchangeRates                String?  @db.Text
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  @@map("system_config")
}

model EmailTemplate {
  id          String   @id @default(uuid())
  name        String
  type        String // QUOTATION_SENT | PAYMENT_CONFIRMED | VOUCHER_ISSUED | REQUEST_CREATED | CUSTOM
  subject     String
  bodyHtml    String
  isActive    Boolean  @default(true)
  description String?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("email_templates")
}

model Task {
  id          String  @id @default(uuid())
  title       String
  description String?
  dueDate     String
  priority    String
  status      String  @default("PENDIENTE")

  relatedEntityType  String?
  relatedEntityId    String?
  relatedEntityLabel String?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([dueDate])
  @@map("tasks")
}

model Notification {
  id                String   @id @default(uuid())
  userId            String
  title             String
  message           String
  type              String   @default("INFO")
  isRead            Boolean  @default(false)
  relatedEntityId   String?
  relatedEntityType String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@map("notifications")
}

// ─── NOMENCLADORES ──────────────────────────────────────────
// Catálogos administrables (país, ciudad, región, nacionalidad, tipo/marca/modelo de auto).
// Alimentan combobox de sugerencia en el frontend; los campos de texto libre existentes
// (Provider.country/city, Request.origin*/destination*, Client.nationality, Service.details
// para Arriendo de Auto) NO se convierten en FK — siguen guardando el valor como string.

model Country {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cities  City[]
  regions Region[]

  @@map("countries")
}

model City {
  id        String   @id @default(uuid())
  name      String
  countryId String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  country Country @relation(fields: [countryId], references: [id])

  @@map("cities")
}

model Region {
  id        String   @id @default(uuid())
  name      String
  countryId String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  country Country @relation(fields: [countryId], references: [id])

  @@map("regions")
}

model Nationality {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("nationalities")
}

model CarType {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("car_types")
}

model CarBrand {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  models CarModel[]

  @@map("car_brands")
}

model CarModel {
  id         String   @id @default(uuid())
  name       String
  carBrandId String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  carBrand CarBrand @relation(fields: [carBrandId], references: [id])

  @@map("car_models")
}
