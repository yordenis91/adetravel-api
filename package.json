{
  "name": "ade-travel-backend",
  "version": "1.0.0",
  "description": "Enterprise backend for AdeTravel travel management system",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "npx prisma migrate deploy && node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "admin:create": "node dist/scripts/create-admin.js",
    "seed:admin": "ts-node prisma/seed-admin.ts",
    "seed:users": "ts-node prisma/seed-users.ts",
    "seed:clients": "ts-node prisma/seed-clients.ts",
    "seed:providers": "ts-node prisma/seed-providers.ts",
    "seed:catalogs": "ts-node prisma/seed-catalogs.ts",
    "seed:config": "ts-node prisma/seed-system-config.ts",
    "seed:flow": "ts-node prisma/seed-flow.ts",
    "seed:all": "npm run seed:admin && npm run seed:users && npm run seed:config && npm run seed:catalogs && npm run seed:clients && npm run seed:providers && npm run seed:flow",
    "pii:encrypt-backfill": "ts-node prisma/scripts/encrypt-existing-client-pii.ts",
    "pii:encrypt-services-backfill": "node dist/ops/encrypt-existing-service-pii.js",
    "pii:rotate-key": "ts-node prisma/scripts/rotate-pii-key.ts",
    "smtp:encrypt-password": "ts-node prisma/scripts/encrypt-smtp-password.ts",
    "lint": "eslint .",
    "lint:ci": "eslint . --max-warnings 261",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --passWithNoTests",
    "test:e2e": "bash scripts/test-e2e.sh",
    "restore:drill": "bash scripts/restore-drill.sh"
  },
  "keywords": [
    "node",
    "typescript",
    "express",
    "prisma",
    "postgresql"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1150.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@react-pdf/renderer": "^4.9.0",
    "@sentry/node": "^10.76.2",
    "axios": "^1.16.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.2.1",
    "nodemailer": "^10.1.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "prisma": "^7.10.0",
    "react": "^19.3.0",
    "sanitize-html": "^2.13.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jest": "^30.2.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "overrides": {
    "mysql2": "^3.24.5",
    "deepmerge-ts": "^8.0.2"
  }
}
