# Variables de entorno de la API. Copiar a .env (local) o cargarlas como variables/secretos del
# servicio en Easypanel. Nunca subir valores reales al repo. La validación está en src/config/env.ts:
# si falta una obligatoria, la API no arranca y dice cuál.
# Lista de comprobación antes de salir a producción: OPERATIONS.md, "Lista de comprobación de salida".

# ── Obligatorias ──────────────────────────────────────────────────────────────────────────────
NODE_ENV=production
# postgresql://USUARIO:CONTRASEÑA@HOST:5432/BASE?schema=public
DATABASE_URL=
# Mínimo 16 caracteres; se recomiendan 32 o más y aleatorios (openssl rand -hex 32).
JWT_SECRET=
# 64 caracteres hex (openssl rand -hex 32). Cifra pasaporte y cuenta bancaria de clientes y la
# contraseña SMTP. Si se pierde, esos datos no se pueden leer: guardarla fuera del servidor
# (ver PII_ENCRYPTION.md y la sección de backups de OPERATIONS.md).
PII_ENCRYPTION_KEY=
# URL pública del cliente (CORS y enlaces de los correos).
FRONTEND_URL=https://app.ejemplo.cl

# ── Servidor y sesión ─────────────────────────────────────────────────────────────────────────
PORT=3000
JWT_EXPIRES_IN=1d
# El registro público queda apagado: en producción los usuarios entran por invitación.
ALLOW_PUBLIC_REGISTRATION=false

# ── Rate limiting (ver src/app.ts y src/middlewares/rate-limit.middleware.ts) ─────────────────
# Límite global de /api por usuario (por IP si no hay sesión). Cada pestaña con la sesión
# abierta consume ~60 peticiones por ventana solo en el polling de notificaciones (cada 30 s)
# y cada pantalla hace 7-14 llamadas: con 100 un uso normal termina en 429 y el usuario es
# expulsado. 1000 deja margen para un uso intenso y sigue frenando abusos.
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW_MINUTES=15
# Límite de POST /api/auth/login por IP. Solo cuentan los intentos fallidos.
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# ── Correo ────────────────────────────────────────────────────────────────────────────────────
# live: a los destinatarios reales (solo producción). redirect: todo a EMAIL_REDIRECT_TO, con el
# destinatario original en el asunto (demo). off: no se envía nada.
EMAIL_DELIVERY=live
# Obligatoria si EMAIL_DELIVERY=redirect.
# EMAIL_REDIRECT_TO=pruebas@tu-dominio.cl
# SMTP: también se puede configurar desde Configuración > Correo (se guarda cifrado en la base);
# estas variables son el valor por defecto.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=no-responder@tu-dominio.cl

# ── Reglas de negocio (DECISIONES_PENDIENTES.md) ──────────────────────────────────────────────
ALLOW_PARTIAL_PAYMENTS=false
BLOCK_EXPIRED_QUOTATIONS=true

# ── Integraciones ─────────────────────────────────────────────────────────────────────────────
# Tasas de cambio (Configuración > Divisas). Sin ella no hay sincronización, ni manual ni automática.
# La frecuencia (por defecto 3 veces al día) se cambia desde esa pantalla.
# CURRENCY_API_KEY=

# ── Observabilidad ────────────────────────────────────────────────────────────────────────────
# Sin DSN, Sentry queda apagado. Los eventos salen sin datos personales (src/utils/sentry-scrub.ts).
# SENTRY_DSN=
# Para separar la demo de producción en Sentry (por defecto, NODE_ENV).
# SENTRY_ENVIRONMENT=production

# ── Backups (OPERATIONS.md, "Backups y recuperación ante desastres") ─────────────────────────
# Sin las 4 primeras, el backup no se programa (aviso en el log al arrancar).
# BACKUP_S3_ENDPOINT=https://minio.tu-dominio.cl
# BACKUP_S3_BUCKET=adetravel-backups
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_REGION=us-east-1
BACKUP_CRON=0 3 * * *
BACKUP_RETENTION_DAYS=30

# ── Alertas y trabajos programados (OPERATIONS.md, "Alertas") ────────────────────────────────
# Recibe las alertas de backup fallido y disco casi lleno (respeta EMAIL_DELIVERY).
# ALERT_EMAIL=operaciones@tu-dominio.cl
# Dead man's switch del backup (p. ej. healthchecks.io): avisa si el backup falla o deja de correr.
# BACKUP_HEARTBEAT_URL=https://hc-ping.com/<uuid>
DISK_CHECK_PATH=/
DISK_CHECK_CRON=*/30 * * * *
DISK_ALERT_MIN_FREE_PERCENT=15
# Con más de una réplica, solo una con true (las demás false): si no, backups y avisos se duplican.
JOBS_ENABLED=true

# ── Solo para scripts (no los lee la API en marcha) ───────────────────────────────────────────
# npm run seed:admin (prisma/seed-admin.ts): primer administrador. Borrarlas después de usarlas.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_FULL_NAME=
# ADMIN_AGENCY_ROLE=GERENTE
# npm run pii:rotate-key (prisma/scripts/rotate-pii-key.ts, ver PII_ENCRYPTION.md).
# PII_ENCRYPTION_KEY_OLD=
# PII_ENCRYPTION_KEY_NEW=
