# Rate limiting (ver src/app.ts y src/middlewares/rate-limit.middleware.ts)

# Límite global de /api por usuario (por IP si no hay sesión). Cada pestaña con la sesión
# abierta consume ~60 peticiones por ventana solo en el polling de notificaciones (cada 30 s)
# y cada pantalla hace 7-14 llamadas: con 100 un uso normal termina en 429 y el usuario es
# expulsado. 1000 deja margen para un uso intenso y sigue frenando abusos.
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW_MINUTES=15

# Límite de POST /api/auth/login por IP. Solo cuentan los intentos fallidos.
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# Envío de correo. live: a los destinatarios reales (solo producción). redirect: todo a
# EMAIL_REDIRECT_TO, con el destinatario original en el asunto (demo). off: no se envía nada.
EMAIL_DELIVERY=live
# EMAIL_REDIRECT_TO=pruebas@tu-dominio.cl
