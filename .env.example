# Rate limiting (ver src/app.ts y src/middlewares/rate-limit.middleware.ts)

# Límite global de /api por IP. Cada pestaña del cliente con la sesión abierta
# consume ~60 peticiones por ventana (polling de notificaciones cada 30 s):
# dimensionar según cuántos usuarios comparten IP.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MINUTES=15

# Límite de POST /api/auth/login por IP. Solo cuentan los intentos fallidos.
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
